# .gitignore
# ── Python ──────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# ── Secrets (never commit real keys or passwords) ─────────────────────────────
# Templates like backend/.env.example and frontend/.env.local.example ARE tracked.
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example
*.env
!*.env.example
!**/.env.example
.env.local
*.env.local

# ── Node / Next.js ──────────────────────────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
tsconfig.tsbuildinfo

# ── Docker ──────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── OS ──────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDEs ────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
