# ── Gemini / AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Tried first. If this model is at quota (429), the agent walks GEMINI_MODELS.
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated generateContent text models (function calling). Do not list
# image, TTS, Live, embedding, or Veo IDs — they cannot run this chat agent.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3-flash,gemini-3.5-flash,gemini-3.6-flash

# ── ClickHouse Cloud (via MCP) ─────────────────────────────────────────────────
# There is no default Cloud password. Copy host + password from
# ClickHouse Cloud → your service → Connect.
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_cloud_password_here
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_DATABASE=abota
# Seconds for connect + query (HTTP read) and ClickHouse max_execution_time
CLICKHOUSE_QUERY_TIMEOUT=15

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
