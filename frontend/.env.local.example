# Leave NEXT_PUBLIC_API_URL unset locally so the browser calls same-origin /api.
# NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# Vercel (frontend only): set NEXT_PUBLIC_API_URL to the public Railway API, e.g.
# NEXT_PUBLIC_API_URL=https://acceptable-laughter-production-4884.up.railway.app
# Do not use *.railway.internal from Vercel — that DNS only works inside Railway.
